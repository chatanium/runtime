package main

import (
	"testing"

	corewire "github.com/thirdscam/chatanium/proto/core-v2"
	discord "github.com/thirdscam/chatanium/shared/discord-v2"
	"google.golang.org/protobuf/encoding/protojson"
)

func TestBotStartsWithoutLocalChannelConfiguration(t *testing.T) {
	init := new(corewire.InitContext)
	if err := protojson.Unmarshal([]byte(`{"grants":{"backends":[{"backendId":"discord","protocolMajor":2,"capabilities":[{"name":"discord.event.MESSAGE_CREATE","resourceScopes":[{"allResources":true}]},{"name":"discord.rest.ChannelMessageSendComplex","resourceScopes":[{"allResources":true}]}]}]}}`), init); err != nil {
		t.Fatal(err)
	}
	ctx := t.Context()
	bot := &Bot{api: new(discord.Client)}
	defer bot.OnStage(ctx, &corewire.StageRequest{Stage: corewire.Stage_STAGE_STOP})
	if err := bot.OnStage(ctx, &corewire.StageRequest{Stage: corewire.Stage_STAGE_INIT, InitContext: init}); err != nil {
		t.Fatal(err)
	}
	status, err := bot.GetStatus(ctx)
	if err != nil || status.GetReadiness() != corewire.Readiness_READINESS_READY {
		t.Fatalf("bot not ready after INIT: %v, %v", status, err)
	}
}
