package main

import (
	"context"
	_ "embed"
	"errors"
	"fmt"
	"os"
	"strconv"
	"strings"
	"sync"
	"time"

	"github.com/hashicorp/go-plugin"
	corewire "github.com/thirdscam/chatanium/proto/core-v2"
	wire "github.com/thirdscam/chatanium/proto/discord-v2"
	core "github.com/thirdscam/chatanium/shared/core-v2"
	discord "github.com/thirdscam/chatanium/shared/discord-v2"
	"google.golang.org/grpc"
	"google.golang.org/grpc/codes"
	"google.golang.org/grpc/status"
	"google.golang.org/protobuf/encoding/protojson"
)

// This exact file is also the OCI image's manifest declaration.
//go:embed manifest.json
var manifestJSON []byte

type Bot struct {
	mu      sync.Mutex
	api     *discord.Client
	ready   bool
	running bool
	stopped bool
	life    context.Context
	cancel  context.CancelFunc
	active  int
	changed chan struct{}
}

func (b *Bot) bind(_ context.Context, conn grpc.ClientConnInterface) error {
	var err error
	b.api, err = discord.NewClient(conn)
	return err
}

func (b *Bot) GetManifest(ctx context.Context) (*corewire.ModuleManifest, error) {
	if err := ctx.Err(); err != nil {
		return nil, err
	}
	out := new(corewire.ModuleManifest)
	if err := (protojson.UnmarshalOptions{DiscardUnknown: false}).Unmarshal(manifestJSON, out); err != nil {
		return nil, err
	}
	return out, nil
}

func (b *Bot) GetStatus(ctx context.Context) (*corewire.Status, error) {
	if err := ctx.Err(); err != nil {
		return nil, err
	}
	b.mu.Lock()
	defer b.mu.Unlock()
	readiness := corewire.Readiness_READINESS_NOT_READY
	if b.ready {
		readiness = corewire.Readiness_READINESS_READY
	}
	return &corewire.Status{Readiness: readiness}, nil
}

func (b *Bot) OnStage(ctx context.Context, req *corewire.StageRequest) error {
	if err := ctx.Err(); err != nil {
		return err
	}
	if req == nil {
		return errors.New("missing lifecycle stage")
	}
	switch req.Stage {
	case corewire.Stage_STAGE_INIT:
		return b.initialize(req.InitContext)
	case corewire.Stage_STAGE_START:
		b.mu.Lock()
		defer b.mu.Unlock()
		if !b.ready || b.running || b.stopped {
			return errors.New("invalid START")
		}
		b.running = true
		return nil
	case corewire.Stage_STAGE_DRAIN, corewire.Stage_STAGE_STOP:
		b.mu.Lock()
		b.ready, b.running = false, false
		if req.Stage == corewire.Stage_STAGE_STOP {
			b.stopped = true
		}
		if b.cancel != nil {
			b.cancel()
		}
		b.mu.Unlock()
		return b.join(ctx)
	default:
		return errors.New("unsupported lifecycle stage")
	}
}

func (b *Bot) initialize(init *corewire.InitContext) error {
	b.mu.Lock()
	defer b.mu.Unlock()
	if b.life != nil || b.stopped || b.api == nil || init == nil || init.Grants == nil {
		return errors.New("invalid INIT or missing helpers/grants")
	}
	var grants []*corewire.CapabilityGrant
	for _, backend := range init.Grants.Backends {
		if backend != nil && backend.BackendId == "discord" && backend.ProtocolMajor == 2 {
			grants = append(grants, backend.Capabilities...)
		}
	}
	if !hasGrant(grants, "discord.event.MESSAGE_CREATE") || !hasGrant(grants, "discord.rest.ChannelMessageSendComplex") {
		return errors.New("MESSAGE_CREATE and ChannelMessageSendComplex grants required")
	}
	b.life, b.cancel = context.WithCancel(context.Background())
	b.changed = make(chan struct{})
	b.ready = true
	return nil
}

func hasGrant(grants []*corewire.CapabilityGrant, name string) bool {
	for _, grant := range grants {
		if grant.GetName() == name && len(grant.GetResourceScopes()) != 0 {
			return true
		}
	}
	return false
}

func snowflake(s string) bool {
	if len(s) < 1 || len(s) > 20 || s[0] == '0' {
		return false
	}
	value, err := strconv.ParseUint(s, 10, 64)
	return err == nil && value != 0
}

func (b *Bot) join(ctx context.Context) error {
	for {
		b.mu.Lock()
		if b.active == 0 {
			b.mu.Unlock()
			return nil
		}
		changed := b.changed
		b.mu.Unlock()
		select {
		case <-ctx.Done():
			return ctx.Err()
		case <-changed:
		}
	}
}

func (b *Bot) OnEvent(ctx context.Context, event *corewire.EventEnvelope) error {
	b.mu.Lock()
	if !b.running || b.stopped {
		b.mu.Unlock()
		return errors.New("event outside RUNNING")
	}
	b.active++
	life := b.life
	b.mu.Unlock()
	defer func() {
		b.mu.Lock()
		b.active--
		close(b.changed)
		b.changed = make(chan struct{})
		b.mu.Unlock()
	}()
	bounded, cancel := context.WithTimeout(ctx, 10*time.Second)
	defer cancel()
	stop := context.AfterFunc(life, cancel)
	defer stop()
	payload, err := discord.DecodeEvent(event)
	if err != nil {
		return err
	}
	created, ok := payload.(*wire.MessageCreateEvent)
	if !ok {
		return nil
	}
	message := created.Message.GetValue()
	if message == nil || !snowflake(message.GuildId.GetValue()) || !snowflake(message.ChannelId.GetValue()) {
		return nil
	}
	author := message.Author.GetValue()
	if author == nil || author.Bot.GetValue() || !snowflake(author.Id.GetValue()) || strings.TrimSpace(message.Content.GetValue()) != "!ping" {
		return nil
	}
	_, err = b.api.ChannelMessageSendComplex(bounded, message.ChannelId.GetValue(), &discord.MessageSendView{Content: "pong"})
	if status.Code(err) == codes.PermissionDenied {
		return nil
	}
	return err
}

func main() {
	bot := new(Bot)
	p, err := core.NewModulePlugin(context.Background(), bot, bot.bind, core.TransportLimits{MaxReceiveBytes: 4 << 20, MaxSendBytes: 4 << 20})
	if err != nil {
		fmt.Fprintln(os.Stderr, "module bootstrap failed")
		os.Exit(1)
	}
	defer p.Close()
	plugin.Serve(p.ServeConfig())
}

var _ core.ModuleHooks = (*Bot)(nil)
